% pt-common-fr.sty -- Jumeau français de pt-common.sty pour les articles PT
% Source : pt-common.sty (v2, 2026-04-04)
%
% Différences vs pt-common.sty :
%   1. babel chargé en [french] au lieu de [english]
%   2. Patch \AtBeginDocument{\shorthandoff{:!?;}} : neutralise les
%      shorthands babel-french qui cassent \cref / \csname (les
%      caractères `:`, `!`, `?`, `;` deviennent actifs et insèrent du
%      \penalty incompatible avec la construction de \csname r@<label>...
%      → essentiel pour tous les articles utilisant cleveref + babel-french)
%   3. csquotes ajouté (guillemets français corrects)
%   4. Environnements de théorème renommés en FR (theoreme, lemme, etc.)
%   5. \GFT renommé pour rendu « TFS » (Théorème Fondamental des Sauts)

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pt-common-fr}[2026/05/15 Persistence Theory common macros — FR v1]

% ============================================================
% Packages de base
% ============================================================
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[french]{babel}
\RequirePackage{csquotes}

% Mathématiques
\RequirePackage{amsmath,amssymb,amsthm,mathtools}
\RequirePackage{bm}
\RequirePackage{bbm}
\RequirePackage{dsfont}
\RequirePackage{braket}

% Graphiques et figures
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta, calc, positioning, decorations.markings,
  decorations.pathreplacing, patterns, shapes.geometric, matrix,
  intersections, fit, backgrounds, chains}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% Boîtes de théorème colorées
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{theorems, breakable, skins}

% Références
\RequirePackage{hyperref}
\RequirePackage[nameinlink]{cleveref}

% PATCH CRITIQUE : neutraliser les shorthands babel-french qui cassent
% \cref. Sans ceci, tout \cref{label} dans le corps explose avec
% « Missing \endcsname inserted / Argument of \@firstoffive has an extra } »
% parce que les caractères `:`, `!`, `?`, `;` sont actifs et insèrent
% des tokens \penalty dans les arguments de \csname.
\AtBeginDocument{\shorthandoff{:!?;}}

% Bibliographie
\RequirePackage[numbers,sort&compress]{natbib}

% Tableaux
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{array}

% Divers
