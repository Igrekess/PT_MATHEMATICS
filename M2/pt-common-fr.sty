% ============================================================
% Annotations Lean (PT_LEAN cross-references)
% ============================================================
%
%  Marqueurs de statut de formalisation Lean 4 (PT_LEAN/).
%  Mêmes commandes que dans le préambule de la monographie ;
%  voir PT_MONOGRAPHY/LEAN_INDEX.md pour la table de correspondance.
%
%  Usage type :
%    \begin{theorem}[T1]\label{thm:T1}\leanProved{PT.Sieve.T1ForbiddenTransitions.T1\_antidiag}
%      ...
%    \end{theorem}

\definecolor{leangreen}{RGB}{60,140,40}    % Démontré (sorry-free)
\definecolor{leanorange}{RGB}{210,120,30}  % Partiel
\definecolor{leanblue}{RGB}{60,90,170}     % Import externe (Mathlib, Čencov)
\definecolor{leanred}{RGB}{180,60,60}      % Pas encore formalisé

\newif\ifleanrefsvisible
\leanrefsvisibletrue  % \leanrefsvisiblefalse pour masquer

% Badges statut (sans identifier)
\newcommand{\thmLeanProved}{%
  \ifleanrefsvisible
    \hfill\textcolor{leangreen}{\ensuremath{\checkmark_{\!L}}}%
  \fi}
\newcommand{\thmLeanPartial}{%
  \ifleanrefsvisible
    \hfill\textcolor{leanorange}{\ensuremath{\sim_{\!L}}}%
  \fi}
\newcommand{\thmLeanExternal}{%
  \ifleanrefsvisible
    \hfill\textcolor{leanblue}{\ensuremath{\star_{\!L}}}%
  \fi}
\newcommand{\thmLeanTodo}{%
  \ifleanrefsvisible
    \hfill\textcolor{leanred}{\ensuremath{\circ_{\!L}}}%
  \fi}

% Référence Lean en ligne (avec backslash escape `_` -> `\_`)
\newcommand{\leanref}[1]{%
  \ifleanrefsvisible
    \hfill\fbox{\textsf{\scriptsize Lean: \texttt{#1}}}%
  \fi}

% Combinés : badge + identifier
\newcommand{\leanProved}[1]{\thmLeanProved\leanref{#1}}
\newcommand{\leanPartial}[1]{\thmLeanPartial\leanref{#1}}
\newcommand{\leanExternal}[1]{\thmLeanExternal\leanref{#1}}
\newcommand{\leanTodo}[1]{\thmLeanTodo\leanref{#1}}

% Légende (à insérer une fois, dans l'introduction)
\newcommand{\leanLegend}{%
  \begin{quote}\footnotesize\noindent
  \textsf{Annotations Lean.} Chaque théorème porte (le cas échéant) un
  symbole à droite indiquant son statut de formalisation dans le dépôt
  \texttt{PT\_LEAN} (Lean~4) :
  \begin{itemize}\setlength{\itemsep}{0pt}
    \item \textcolor{leangreen}{\ensuremath{\checkmark_{\!L}}} : preuve Lean complète, 0 \texttt{sorry}.
    \item \textcolor{leanorange}{\ensuremath{\sim_{\!L}}} : partiellement formalisé.
    \item \textcolor{leanblue}{\ensuremath{\star_{\!L}}} : import externe (Mathlib, Čencov 1982).
    \item \textcolor{leanred}{\ensuremath{\circ_{\!L}}} : pas encore formalisé.
  \end{itemize}
  Table complète : \texttt{LEAN\_INDEX.md} à la racine du dépôt monographe.
  \end{quote}}

